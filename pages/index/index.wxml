<view class="container">
  <view class="hero fade-up">
    <view class="bg-flow"></view>
    <view class="aura"></view>
    <view class="hero-inner">
      <view class="taiji-wrap">
        <view class="taiji">
          <view class="t-dark"></view>
          <view class="t-top"></view>
          <view class="t-bot"></view>
          <view class="eye eye-t"></view>
          <view class="eye eye-b"></view>
        </view>
      </view>
      <view class="kicker">象数推演 · 传统文化研习</view>
      <view class="title">观梅数</view>
      <view class="sub">梅花易数 · 小六壬</view>
      <view class="divider"><view class="ln"></view><view class="dia">❖</view><view class="ln"></view></view>
