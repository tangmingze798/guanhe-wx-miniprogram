.page-hint { font-size: 23rpx; color: var(--muted); line-height: 1.7; margin-bottom: 22rpx; background: rgba(176,141,87,.08); border-radius: 14rpx; padding: 18rpx 20rpx; }

.numrow { display: flex; align-items: center; justify-content: center; margin: 18rpx 0; gap: 18rpx; }
.ni { width: 180rpx; background: var(--panel2); border: 1rpx solid var(--line); border-radius: 12rpx; padding: 16rpx; text-align: center; color: var(--txt); font-size: 28rpx; }
.plus { color: var(--gold); font-size: 36rpx; }

.label { font-size: 24rpx; color: var(--muted); margin: 22rpx 0 10rpx; }
.qinput { width: 100%; background: var(--panel2); border: 1rpx solid var(--line); border-radius: 12rpx; padding: 18rpx; color: var(--txt); font-size: 26rpx; }
.mt { margin-top: 24rpx; }

/* 硬币动画 */
.coins { display: flex; justify-content: center; gap: 30rpx; margin: 30rpx 0; }
.coin { width: 90rpx; height: 90rpx; border-radius: 50%; background: linear-gradient(135deg,#cdbfa0,#8a7a55); color: #14110e; font-size: 48rpx; text-align: center; line-height: 90rpx; animation: flip .5s linear infinite; }
@keyframes flip { 0%{transform:rotateY(0)} 100%{transform:rotateY(360deg)} }

/* 吉凶大结论 */
.hero-verdict { border-radius: 24rpx; padding: 44rpx 30rpx; text-align: center; margin-bottom: 24rpx; border: 1rpx solid var(--line); box-shadow: 0 10rpx 30rpx rgba(0,0,0,.3); position: relative; overflow: hidden; }
.hero-verdict::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 4rpx; background: linear-gradient(90deg, transparent, var(--gold), transparent); }
.lv-bg-ji { background: rgba(123,196,127,.16); }
.lv-bg-xiaoji { background: rgba(159,208,138,.13); }
.lv-bg-ping { background: rgba(176,141,87,.16); }
.lv-bg-ban { background: rgba(217,176,106,.13); }
.lv-bg-xiong { background: rgba(224,122,95,.18); }
.lv-bg-xiaoxiong { background: rgba(217,140,106,.15); }
.vbig { font-size: 96rpx; font-weight: 800; color: var(--txt); letter-spacing: 10rpx; text-shadow: 0 2rpx 10rpx rgba(0,0,0,.4); }
.vtag { font-size: 24rpx; color: var(--muted); margin: 6rpx 0 18rpx; }
.vplain { font-size: 28rpx; color: var(--txt); line-height: 1.7; }
.vplain.gold { color: var(--gold); margin-top: 10rpx; }

/* 卦象 */
.gua-lab { font-size: 26rpx; color: var(--gold-bright); margin-bottom: 16rpx; letter-spacing: 1rpx; }
.hex { padding: 22rpx 0 18rpx; margin: 6rpx 0 10rpx; background: rgba(176,141,87,.05); border: 1rpx solid var(--line); border-radius: 14rpx; }
.lnrow { height: 16rpx; margin: 9rpx 0; display: flex; justify-content: center; }
.bar { width: 220rpx; height: 14rpx; background: linear-gradient(90deg, var(--txt), var(--gold-bright)); border-radius: 4rpx; }
.yin { width: 220rpx; display: flex; justify-content: space-between; }
.yin .half { width: 92rpx; height: 14rpx; background: linear-gradient(90deg, var(--gold-bright), var(--txt)); border-radius: 4rpx; }
.dong { box-shadow: 0 0 0 3rpx var(--red); }
.gua-name { font-size: 34rpx; font-weight: 700; color: var(--txt); text-align: center; margin-top: 8rpx; }
.gua-meta { font-size: 22rpx; color: var(--muted); text-align: center; margin-bottom: 14rpx; }
.tuan { font-size: 28rpx; color: var(--txt); text-align: center; }
.yi { font-size: 24rpx; color: var(--muted); line-height: 1.7; margin-top: 8rpx; text-align: center; }

.ptext { font-size: 26rpx; color: var(--txt); line-height: 1.8; margin-top: 14rpx; }
.catcard { margin-top: 16rpx; padding: 16rpx 18rpx; border-left: 6rpx solid var(--gold); background: rgba(176,141,87,.10); border-radius: 0 12rpx 12rpx 0; }
.catname { font-size: 26rpx; color: var(--gold); font-weight: 700; margin-bottom: 8rpx; }
